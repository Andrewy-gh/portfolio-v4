{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-agent-readiness",
  "main": "cloudflare/markdown-negotiation.js",
  "compatibility_date": "2026-07-22",
  "routes": [
    {
      "pattern": "andrewy.me/*",
      "zone_name": "andrewy.me"
    }
  ],
  // Records which representation each request was served. Nothing else in the
  // stack can see that: HTML and Markdown share the URL "/" and the choice is
  // made from the Accept header inside the worker.
  "analytics_engine_datasets": [
    {
      "binding": "AI_TRAFFIC",
      "dataset": "portfolio_ai_traffic"
    }
  ]
}
